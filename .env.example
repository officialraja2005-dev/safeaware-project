# Copy this file to .env and fill in your Supabase project's values.
# Find these under Project Settings -> API in your Supabase dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# ==========================================
# MongoDB Configuration (Local or Atlas)
# ==========================================
# For Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/safeaware

# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/safeaware?retryWrites=true&w=majority

PORT=5000
JWT_SECRET=safeaware_super_secure_jwt_secret_key_2026

